{
  "version": "v0.6-selected8",
  "assumptions": {
    "symbolBasePoints": {
      "cherry": 1,
      "lemon": 2,
      "bell": 3,
      "diamond": 5,
      "seven": 10
    },
    "linePayouts": {
      "cherry": 30,
      "lemon": 60,
      "bell": 120,
      "diamond": 300,
      "seven": 1500
    },
    "baseHandLimit": 4,
    "noUnlistedItems": true,
    "globalMultiplier": {
      "num": 1,
      "den": 1
    },
    "rngRollSpace": "integer_0_through_9999_inclusive",
    "rngPassRule": "roll < triggerChanceBasisPoints",
    "boardsProvidedAsServerDrawOverridesForUnitTests": true
  },
  "testCases": [
    {
      "id": "S8-01",
      "title": "No seven schedules exactly one next-Hand weight bonus",
      "activeItems": [
        "seven_tracker"
      ],
      "given": {
        "finalPhysicalBoard": [
          "cherry",
          "cherry",
          "cherry",
          "cherry",
          "cherry",
          "cherry",
          "cherry",
          "cherry",
          "cherry"
        ],
        "currentHandSequence": 5
      },
      "when": "HAND_RESOLVED",
      "expected": {
        "pendingNextHandWeightBuffs": [
          {
            "sourceItemId": "seven_tracker",
            "symbol": "seven",
            "amount": 4,
            "targetHandSequence": 6
          }
        ],
        "nextHandWeightsNoOtherModifiers": [
          30,
          25,
          20,
          15,
          14
        ],
        "nextHandSevenProbability": "14/104"
      }
    },
    {
      "id": "S8-02",
      "title": "Mirror copies a full column and scores both real cherry lines",
      "activeItems": [
        "mirror_copier"
      ],
      "given": {
        "drawnBoard": [
          "cherry",
          "bell",
          "diamond",
          "cherry",
          "lemon",
          "seven",
          "cherry",
          "diamond",
          "bell"
        ],
        "remainingCharges": 2
      },
      "rngOverrides": {
        "mirror_copier.activationRollBp": 999
      },
      "when": "SPIN",
      "expected": {
        "finalPhysicalBoard": [
          "cherry",
          "bell",
          "cherry",
          "cherry",
          "lemon",
          "cherry",
          "cherry",
          "diamond",
          "cherry"
        ],
        "physicalChanged": true,
        "actualWinningLineIds": [
          "col_left",
          "col_right"
        ],
        "baseScore": "16",
        "actualLineScore": "60",
        "patternBonus": "0",
        "spinScore": "76",
        "remainingCharges": 1
      }
    },
